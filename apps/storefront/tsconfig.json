{
  "extends": [
    "@repo/typescript-config/react-library.json",
    "@repo/typescript-config/nextjs.json"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@repo/codegen/*": ["../../packages/codegen/src/*"],
      "@repo/tenant-orm/*": ["../../packages/tenant-orm/src/*"],
      "@repo/ui/*": ["../../packages/ui/src/*"],
      "@repo/shared-utils/*": ["../../packages/shared-utils/src/*"],
      "@repo/editor/*": ["../../packages/editor/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "sentry.*.config.ts"]
}
