# E-Commerce Platform - Environment Variables
# Copy this file to .env (local development) or .env.local and fill in the values.
# For deployment, configure these in Doppler or your secrets manager.

# ============ Supabase (PostgreSQL) ============
DATABASE_URL="postgresql://postgres:<password>@127.0.0.1:54322/postgres"
SUPABASE_JWT_SECRET="your-32-character-supabase-jwt-secret-here"

# ============ Clerk (Authentication) ============
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxx..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx..."
CLERK_ISSUER="https://<your-domain>.clerk.accounts.dev"
CLERK_JWKS_URL="https://<your-domain>.clerk.accounts.dev/enterprise/v1/<app-id>/.well-known/jwks.json"
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx..."

# ============ Backend API ============
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:8000"
API_BASE_URL="http://localhost:8000"

# ============ App Settings ============
APP_ENV="development"

# ============ Cloudinary Settings ============
# Set these via Doppler — never commit real values
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"