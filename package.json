{
  "name": "multi-tenant-shopify",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant Shopify-style SaaS platform",
  "type": "module",
  "scripts": {
    "supabase:env": "doppler secrets download --no-file --format env > supabase/.env",
    "dev": "doppler run -- pnpm turbo run dev",
    "build": "doppler run -- pnpm turbo run build",
    "start": "doppler run -- pnpm turbo run start",
    "dev:": "dotenv -e .env -- turbo run dev",
    "dev:turbo": "turbo run dev",
    "build:": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && del-cli node_modules/*/**/node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,css,scss}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{md,css,scss,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.6",
    "del-cli": "^6.0.0",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
